# Serverda: ~/yandex-probe/.env  (git'ga qo'shilmasin)
PROBE_API_KEY=almashtiring-kamida-16-belgi
PROBE_HOST=0.0.0.0
PROBE_PORT=3060
# Bir nechta telefon ulangan bo'lsa
ADB_SERIAL=b5548dcc
# Bitta probe uchun maksimal vaqt (soniya)
PROBE_TIMEOUT=30
# Telefon band bo'lsa navbatda kutish (soniya)
MAX_WAIT=45
# Shu marshrut shu soniya ichida qayta so'ralsa xotiradagi natija qaytadi (0 = o'chiq)
FRESH_SECONDS=20
# ML uchun JSONL fayllar
# DATA_DIR=/home/deploy/yandex-probe/data
